{
  "name": "prismcast-studio",
  "version": "2.5.1",
  "description": "PrismCast Studio — Motor nativo em Rust + Tauri v2 para transmissão LAN P2P Ultra-Low Latency, Dual Output (16:9 + 9:16), Multistreaming (Twitch/YouTube/Kick/TikTok), Widgets HTML e Multichat",
  "author": "kayor <kayor@users.noreply.github.com>",
  "homepage": "https://github.com/kayoinreality/PrismCast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "tauri": "tauri",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis,msi",
    "dist:linux": "tauri build --bundles deb,rpm,appimage",
    "rust:check": "cargo check --all-targets",
    "rust:check:desktop": "cargo check --all-targets --features tauri-app",
    "rust:test": "cargo test --all-targets",
    "rust:test:desktop": "cargo test --all-targets --features tauri-app",
    "rust:build": "cargo build --release",
    "rust:build:desktop": "cargo build --release --features tauri-app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
