{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrismCast Studio",
  "version": "2.5.1",
  "identifier": "com.kayor.prismcaststudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist",
    "features": ["tauri-app"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrismCast Studio",
        "width": 1380,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob: https: wss: http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kayor",
    "category": "Video",
    "shortDescription": "Estúdio de transmissão LAN P2P, Dual Output e Multistreaming",
    "longDescription": "PrismCast Studio - Motor nativo em Rust + Tauri v2 para transmissão LAN P2P Ultra-Low Latency, Dual Output (16:9 + 9:16), Multistreaming (Twitch/YouTube/Kick/TikTok), Widgets HTML e Multichat.",
    "icon": [
      "build/32x32.png",
      "build/128x128.png",
      "build/128x128@2x.png",
      "build/icon.ico",
      "build/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "build/icon.ico",
        "uninstallerIcon": "build/icon.ico",
        "headerImage": "build/installer/nsis-header.bmp",
        "uninstallerHeaderImage": "build/installer/nsis-header.bmp",
        "sidebarImage": "build/installer/nsis-sidebar.bmp",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": {
          "pt-BR": {
            "localePath": "build/installer/wix-pt-BR.wxl"
          }
        },
        "bannerPath": "build/installer/wix-banner.bmp",
        "dialogImagePath": "build/installer/wix-dialog.bmp"
      }
    }
  }
}
